# -----------------------------------------------------------------------------
# Pinned component versions used by every install.sh.
#
# These are a known-compatible baseline (mid/late 2025 releases). Newer
# releases almost certainly exist by the time you read this — bump
# deliberately, one layer at a time, and read the upstream release notes
# (CRD API versions change, especially for Envoy AI Gateway, GIE and Kueue).
#
#   ./scripts/check-latest-versions.sh   # shows what is upstream now
#
# An empty value means "install the latest chart version" (fine for a lab,
# bad for reproducibility — pin it after your first successful install).
# -----------------------------------------------------------------------------

# --- platform ---
CILIUM_VERSION=1.18.2
METALLB_VERSION=0.15.2
CERT_MANAGER_VERSION=v1.18.2
NFS_PROVISIONER_VERSION=4.0.18
GPU_OPERATOR_VERSION=v25.3.2
KUBE_PROMETHEUS_STACK_VERSION=
KEDA_VERSION=
LWS_VERSION=0.7.0
KUEUE_VERSION=0.13.4

# --- gateway / routing ---
# Envoy AI Gateway vX.Y requires a matching Envoy Gateway minor; check the
# AI Gateway compatibility matrix before bumping either one.
ENVOY_GATEWAY_VERSION=v1.5.0
AI_GATEWAY_VERSION=v0.3.0
GATEWAY_API_INFERENCE_EXTENSION_VERSION=v1.0.0

# --- inference ---
VLLM_STACK_CHART_VERSION=

# --- training / mlops ---
KUBERAY_VERSION=1.4.2
KUBEFLOW_TRAINER_VERSION=v2.0.0
MLFLOW_CHART_VERSION=
MINIO_CHART_VERSION=

# --- security ---
KEYCLOAK_CHART_VERSION=
OPENBAO_CHART_VERSION=
EXTERNAL_SECRETS_VERSION=
KYVERNO_VERSION=
FALCO_VERSION=
TRIVY_OPERATOR_VERSION=

# --- observability / reliability ---
OTEL_COLLECTOR_VERSION=
TEMPO_CHART_VERSION=
LOKI_CHART_VERSION=
ALLOY_CHART_VERSION=
OPENCOST_CHART_VERSION=
CHAOS_MESH_VERSION=
NPD_CHART_VERSION=

# --- gitops / pipelines ---
ARGOCD_CHART_VERSION=
ARGO_WORKFLOWS_CHART_VERSION=

# --- advanced inference ---
LLMD_VERSION=v0.2.0

# --- model lifecycle (RL) — verify tag/ref against veRL releases ---
VERL_IMAGE=verlai/verl:app-verl0.5-vllm0.9.1-mcore0.12.2-te2.2
VERL_REF=v0.5.0

# --- apps / workbench / ops ---
OPENWEBUI_CHART_VERSION=
QDRANT_CHART_VERSION=
JUPYTERHUB_CHART_VERSION=
VELERO_CHART_VERSION=
